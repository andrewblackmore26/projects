<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 + C# 9 so Unity 6 compatibility is compiler-enforced.
         Do not raise LangVersion without checking Unity support. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Gridlock.Core</RootNamespace>
    <AssemblyName>Gridlock.Core</AssemblyName>
  </PropertyGroup>

</Project>
