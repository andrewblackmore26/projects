<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile-verifies the Unity view scripts against the installed editor's
    managed assemblies. It stands in for editor script compilation on a machine
    with no activated Unity batchmode licence.

    WHAT THIS CATCHES: C# API errors in UnityProject/Assets/Scripts, including
    use of a type whose module is NOT in the project (for example
    UnityEngine.Collider without com.unity.modules.physics, which is CS1069).
    Core is a ProjectReference, mirroring Unity's split: its own asmdef assembly
    with noEngineReferences.

    WHAT THIS CANNOT CATCH: packaging and asset import. Local package layout,
    build artifacts inside /Core, assembly-identity collisions, .meta state,
    shader compilation, and anything about URP configuration. That class of
    failure once broke Unity completely on this project's ancestor while this
    check stayed green. Only opening the project in the editor proves that side,
    and this machine cannot.

    WHY THE REFERENCE LIST IS EXPLICIT AND NOT A GLOB: Unity's reference set is
    a SUBSET of Managed/UnityEngine/, so globbing that folder makes this tool a
    guaranteed false negative - it would supply modules the project excludes and
    silently pass code Unity rejects. That is exactly how a real CS1069 once
    shipped green. The list below is the non-strippable modules plus one entry
    per com.unity.modules.* the manifest actually declares.

    KEEP IN SYNC: if you add or remove a module in manifest.json, update this
    list and _ExpectedModuleCount together. The drift guard below fails the
    build otherwise, so this cannot rot silently.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>CS1701;CS1702</NoWarn>
    <UnityManaged>C:\Program Files\Unity\Hub\Editor\6000.4.6f1\Editor\Data\Managed\UnityEngine</UnityManaged>
    <ManifestPath>$(MSBuildThisFileDirectory)..\..\UnityProject\Packages\manifest.json</ManifestPath>
    <_ExpectedModuleCount>34</_ExpectedModuleCount>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\UnityProject\Assets\Scripts\**\*.cs" />
    <ProjectReference Include="..\..\Core\Gridlock.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>$(UnityManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
