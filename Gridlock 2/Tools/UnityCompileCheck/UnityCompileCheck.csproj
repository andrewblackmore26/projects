  <!-- Fails the build if manifest.json's module set drifts from the list above,
       which would silently turn this check back into a false negative. -->
  <Target Name="VerifyManifestSync" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="$(ManifestPath)">
      <Output TaskParameter="Lines" ItemName="_ManifestLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_ModuleLine Include="@(_ManifestLine)"
                   Condition="$([System.String]::Copy('%(Identity)').Contains('com.unity.modules.'))" />
    </ItemGroup>
    <Error Condition="'@(_ModuleLine->Count())' != '$(_ExpectedModuleCount)'"
           Text="manifest.json declares @(_ModuleLine->Count()) Unity modules but this check references $(_ExpectedModuleCount). Update the Reference list and _ExpectedModuleCount together, or this check becomes a false negative." />
  </Target>
</Project>
