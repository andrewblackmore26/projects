<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Gridlock.Headless</RootNamespace>
    <AssemblyName>gridlock-headless</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Run on any newer runtime (see Core.Tests for rationale). -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Gridlock.Core.csproj" />
  </ItemGroup>

</Project>
